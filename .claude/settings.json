{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(npx *wrangler*)",
      "Bash(npx *supabase*)",
      "Bash(node *wrangler*)",
      "Bash(node *supabase*)",
      "Bash(supabase test*)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(npx -p *)",
      "Bash(npx --package*)",
      "Bash(npx -c*)",
      "Bash(npx --call*)",
      "Bash(npm exec *)",
      "Bash(npm x *)",
      "Bash(npm explore*)",
      "Bash(npm run live-probe*)",
      "Bash(node scripts/live-sync-probe*)",
      "Bash(node ./scripts/live-sync-probe*)",
      "Bash(node *live-sync-probe*)",
      "Bash(npm *live-probe*)",
      "Bash(npm run smoke*)",
      "Bash(npm *smoke*)",
      "Bash(BASE_URL=* npm*smoke*)",
      "Bash(SMOKE_OAUTH=* npm*smoke*)",
      "Bash(SMOKE_ROUND=* npm*smoke*)",
      "Bash(SMOKE_GAME=* npm*smoke*)",
      "Bash(SMOKE_LIST=* npm*smoke*)",
      "Bash(node scripts/smoke*)",
      "Bash(node ./scripts/smoke*)",
      "Bash(node *smoke.mjs*)",
      "Bash(npm run keep-awake*)",
      "Bash(npm *keep-awake*)",
      "Bash(node scripts/keep-supabase-awake*)",
      "Bash(node ./scripts/keep-supabase-awake*)",
      "Bash(node *keep-supabase-awake*)",
      "Bash(node --run*)",
      "Bash(node *--run*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)"
    ],
    "deny": ["Bash(rm -rf *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/related-tests.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/end-of-turn.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
