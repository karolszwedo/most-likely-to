---
import { messages } from "@/lib/i18n";

// What the game is, for someone who has never played it (join-page-ui, Z1): on / (not signed in) and above the card of
// the host's link /j/<code>. No outer spacing of its own: the place that puts it there gives it. The title is the page's
// h1 on /, an h2 on /dev/room-states (which has its own h1), and a plain p on /j/<code>, where the h1 is the card's.
interface Props {
  titleAs: "h1" | "h2" | "p";
  class?: string;
}

const { titleAs: Title, class: className } = Astro.props;
// The texts of the link's dictionary (src/lib/i18n/pl/link.ts), also the link's preview card's (game-intro.ts).
const t = messages(Astro.locals.lang);
---

<div class:list={["flex flex-col items-center gap-3 text-center", className]}>
  <Title class="text-3xl font-semibold text-balance">{t.link.intro.title}</Title>
  <p class="text-muted-foreground text-balance">{t.link.intro.teaser}</p>
</div>
