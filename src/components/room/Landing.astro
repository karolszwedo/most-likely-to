---
import GameIntro from "@/components/room/GameIntro.astro";
import { buttonVariants } from "@/components/ui/button";
import { messages } from "@/lib/i18n";

// / for someone who is not signed in: only the host has an account, a guest comes in through the host's link.
// The game's title and sentence are the same as above the link's card (GameIntro). The states page has its own h1, so
// there the title is an h2. The slot goes last: on a phone the line about the game's icon (HomeScreenHint), which
// index.astro and /dev/room-states put there.
interface Props {
  titleAs?: "h1" | "h2";
}

const { titleAs = "h1" } = Astro.props;
const t = messages(Astro.locals.lang).pages.landing;
---

<section class="flex flex-col items-center gap-6 py-12 text-center">
  <GameIntro titleAs={titleAs} />
  <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>
    {t.signIn}
  </a>
  <p class="text-muted-foreground text-sm">{t.haveLink}</p>
  <slot />
</section>
