---
import { buttonVariants } from "@/components/ui/button";
import { SURFACE } from "@/components/room/surfaces";
import { messages } from "@/lib/i18n";

// "Wróć do pokoju" above the "Nowa gra" card for a host whose room is still open (in the lobby or with a game in
// play), shared with /dev/room-states.
interface Props {
  roomId: string;
  players: number;
  status: "lobby" | "playing";
}

const { roomId, players, status } = Astro.props;
const t = messages(Astro.locals.lang);
const texts = t.host.openRoom;
const count = t.common.players(players);
---

<div class:list={[SURFACE, "flex items-center justify-between gap-4 p-4"]}>
  <div class="flex min-w-0 flex-col gap-1">
    <p class="font-medium">{texts.title}</p>
    <p class="text-muted-foreground text-sm">{status === "playing" ? texts.playing(count) : texts.lobby(count)}</p>
  </div>
  <a href={`/r/${roomId}`} class:list={buttonVariants({ variant: "secondary" })}>
    {texts.back}
  </a>
</div>
