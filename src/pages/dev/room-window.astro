const stateParam = Astro.url.searchParams.get("state") ?? "";
const sample = Object.hasOwn(SAMPLES, stateParam) ? SAMPLES[stateParam] : null;
---

{isDev && (
  <Layout title="Okno pokoju (dev)">
    {sample ? (
      <>
        <AppHeader signedIn={sample.initial.role === "host"} wide />
        <main class:list={["mx-auto flex w-full flex-col gap-6 px-4 py-8", ROOM_FRAME]}>
          <RoomScreen
            roomId={ROOM_ID}
            initial={sample.initial}
            linkUrl={sample.linkUrl}
            realtime={null}
            preview={{
              idPrefix: "window",
              myVote: sample.myVote,
              host: sample.host,
              questionList: sample.questionList,
              emotes: sample.emotes,
              window: true,
              roleNotice: sample.roleNotice,
            }}
            client:load
          />
        </main>
      </>
    ) : (
      <main class="mx-auto flex max-w-3xl flex-col gap-4 p-6">
        <h1 class="text-2xl font-semibold">Okno pokoju (dev)</h1>
        <p class="text-muted-foreground text-sm">
          Jeden stan pokoju w prawdziwej ramie strony /r/…, do zrzutów całego okna i do sprawdzania paska prowadzącego
          przy dolnej krawędzi. Nagłówek hosta na ekranach hosta, gościa na pozostałych (także współhosta). Wszystkie
          stany obok siebie: /dev/room-states.
        </p>
        <ul class="flex flex-col gap-2 text-sm">
          {Object.entries(SAMPLES).map(([state, { label }]) => (
            <li>
              <a class="text-primary underline" href={`?state=${state}`}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </main>
    )}
  </Layout>
)}
