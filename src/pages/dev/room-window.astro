// Whose screen it is: the host, a guest with the co-host role (S-07: a leader, role "guest", leader true) or a guest.
// The co-host's own row must carry the role too (cohostRoundPlayers), as room_lobby gives it.
type Who = "host" | "cohost" | "guest";

function seat(who: Who): Pick<RoomView, "role" | "leader"> {
  return { role: who === "host" ? "host" : "guest", leader: who !== "guest" };
}

// By default every player was in the room when the round opened, so all of them may vote in it (eligible); no
// latecomer is waiting (requests, set by the samples of S-08).
function voting(
  who: Who,
  me: string,
  players: LobbyPlayer[],
  voted: string[],
  eligible = players.map(({ nick }) => nick),
): RoomView {
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: {
      number: 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "voting",
      eligible,
      voted,
      me_voted: voted.includes(me),
      after_skip: false,
      question: QUESTION,
    },
    requests: [],
    questionsLeft: null,
    questions: null,
    summary: null,
  };
}

// The host's reveal (Ola) unless another screen is asked for: the co-host's is Bartek's.
function revealed(
  players: LobbyPlayer[],
  results: [string, number][],
  abstained: number,
  question: string,
  who: Who = "host",
): RoomView {
  const votes = results.reduce((sum, [, count]) => sum + count, 0);
  return {
    status: "playing",
    ...seat(who),
    me: who === "host" ? "Ola" : "Bartek",
    players,
    round: {
      number: 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "revealed",
      results: results.map(([nick, count]) => ({ nick, votes: count })),
      abstained,
      ballots: votes + abstained,
      question,
    },
    requests: [],
    // Only a leader learns whether the game has a question left.
    questionsLeft: who === "guest" ? null : true,
    questions: null,
    summary: null,
  };
}

// The lobby of a game with a co-host (Bartek): his own screen.
function cohostLobby(): RoomView {
  return {
    status: "lobby",
    ...seat("cohost"),
    me: "Bartek",
    players: cohostRoundPlayers,
    round: null,
    requests: [],
    questionsLeft: null,
    questions: null,
    summary: null,
  };
}

interface Sample {
  label: string;
  initial: RoomView;
  linkUrl?: string;
  myVote?: { target: string | null };
  // The host's buttons, e.g. a question "Na pewno…?" open in the bar.
  host?: HostActionsPreview;
  // The host's "Przejrzyj pytania" in the lobby, e.g. the list unfolded.
  questionList?: QuestionListPreview;
  // The emotes' bar resting or refused, and bubbles on the screen (S-16).
  emotes?: EmotesPreview;
  // The notice of the co-host role, as if the host had just given it (a leader) or taken it (S-07).
  roleNotice?: boolean;
}

