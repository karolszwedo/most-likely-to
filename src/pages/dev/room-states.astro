// in seat order, the host Ola. A removed player is not among them, nor in any reveal.
const historyPlayers: HistoryPlayer[] = [...roundPlayers, eightPlayers[2]].map(({ nick }, color) => ({ nick, color }));
// A reveal's counts for every player of the game, in seat order: those named here, everyone else 0.
function historyResults(votes: Record<string, number>): RoundResult[] {
  return historyPlayers.map(({ nick }) => ({ nick, votes: votes[nick] ?? 0 }));
}
// The view of a started game with these questions, the summary as the Worker makes it of their reveals (historyTotals,
// then gameSummary): each player's sum of the reveals in seat order; none with no reveal. The date is the list's first
// card's.
function historyView(questions: HistoryQuestion[]): GameHistoryView {
  const reveals = questions.flatMap(({ outcome }) => (outcome.kind === "revealed" ? [outcome] : []));
  const totals = historyPlayers.map(({ nick }) => ({
    nick,
    votes: reveals.reduce((sum, { results }) => sum + (results.find((result) => result.nick === nick)?.votes ?? 0), 0),
  }));
  return {
    date: HOST_GAMES[0].date,
    started: true,
    me: "Ola",
    players: historyPlayers,
    summary: reveals.length === 0 ? null : gameSummary({ revealed: reveals.length, totals }),
    questions,
  };
}
