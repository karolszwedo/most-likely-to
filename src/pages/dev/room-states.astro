// Whose screen it is: the host, a guest with the co-host role (S-07: a leader, role "guest", leader true) or a guest.
// The co-host's own row must carry the role too (withCohost), as room_lobby gives it. A leader's view carries the
// players' link in every status (S-09, RoomView.linkUrl), as the Worker sends it; a guest's none. Every player's view
// carries the room's channel key (players-only-live-channel).
type Who = "host" | "cohost" | "guest";

function seat(who: Who): Pick<RoomView, "role" | "leader" | "linkUrl" | "channel_key"> {
  return {
    role: who === "host" ? "host" : "guest",
    leader: who !== "guest",
    linkUrl: who === "guest" ? null : LINK_URL,
    channel_key: CHANNEL_KEY,
  };
}

// questions: the host's game's question list in the lobby (S-06); null until "Przejrzyj pytania", and for a guest.
function lobby(who: Who, me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "lobby",
    ...seat(who),
    me,
    players,
    round: null,
    requests: [],
    returning: [],
    proposals: [],
    own_proposals: { left: 3, waiting: 0 },
    question_count: 15,
    questionsLeft: null,
    moreQuestions: null,
    questions: null,
    summary: null,
  };
}

// The host's lobby once "Przejrzyj pytania" drew the game's question list; [] once every question was removed.
function withQuestions(view: RoomView, questions: ListQuestion[]): RoomView {
  return { ...view, questions };
}

// round: the question's number in the game, whether the host skipped the one before it (S-03), who may vote in it
// (eligible, S-08) and the number of the game's questions (total, game-length; 15 by default). By default every player
// was in the room when the round opened, so all of them may vote in it, and no latecomer is waiting (requests;
// withRequests below).
function voting(
  who: Who,
  me: string,
  players: LobbyPlayer[],
  voted: string[],
  question: string | null = QUESTION,
  round: { number?: number; afterSkip?: boolean; eligible?: string[]; total?: number } = {},
): RoomView {
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: {
      number: round.number ?? 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "voting",
      eligible: round.eligible ?? players.map(({ nick }) => nick),
      voted,
      me_voted: voted.includes(me),
      after_skip: round.afterSkip ?? false,
      question,
    },
    requests: [],
    returning: [],
    proposals: [],
    own_proposals: { left: 3, waiting: 0 },
    question_count: round.total ?? 15,
    questionsLeft: null,
    moreQuestions: null,
    questions: null,
    summary: null,
  };
}

// results: [nick, votes] in seat order, every player of the round; ballots = votes + abstentions. last: null for the
// game's first question of 15; a count for its last one (15 of 15, game-length), how many questions "Jeszcze 5 pytań"
// adds (0: none is left, so only "Zakończ grę" and the note).
function revealed(
  who: Who,
  me: string,
  players: LobbyPlayer[],
  results: [string, number][],
  abstained: number,
  question: string | null = QUESTION,
  last: number | null = null,
): RoomView {
  const votes = results.reduce((sum, [, count]) => sum + count, 0);
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: {
      number: last === null ? 1 : 15,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "revealed",
      results: results.map(([nick, count]) => ({ nick, votes: count })),
      abstained,
      ballots: votes + abstained,
      question,
    },
    requests: [],
    returning: [],
    proposals: [],
    own_proposals: { left: 3, waiting: 0 },
    question_count: 15,
    // Only a leader learns whether the game has a question left, and at its last question how many "Jeszcze 5 pytań"
    // adds.
    questionsLeft: who === "guest" ? null : last === null,
    moreQuestions: who === "guest" ? null : last,
    questions: null,
    summary: null,
  };
}

// A leader skipped the game's last question (15 of 15, game-length): no round follows it, its votes are gone. more: how
// many questions "Jeszcze 5 pytań" adds for a leader, 0 by default (only "Zakończ grę" and the note).
function skipped(who: Who, me: string, players: LobbyPlayer[], more = 0): RoomView {
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: { number: 15, phase: "skipped" },
    requests: [],
    returning: [],
    proposals: [],
    own_proposals: { left: 3, waiting: 0 },
    question_count: 15,
    questionsLeft: who === "guest" ? null : false,
    moreQuestions: who === "guest" ? null : more,
    questions: null,
    summary: null,
  };
}

// The end of the evening: the room is closed, no round, no counts. With no revealed question (closed from the lobby,
// every question skipped, or ended during the first one) there is no summary either.
function closed(who: Who, me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "closed",
    ...seat(who),
    me,
    players,
    round: null,
    requests: [],
    returning: [],
    proposals: [],
    own_proposals: { left: 3, waiting: 0 },
    question_count: 15,
    questionsLeft: null,
    moreQuestions: null,
    questions: null,
    summary: null,
  };
}

// The end of a game with reveals (S-15): sums as room_lobby would give them (game_totals: [nick, votes] in seat order,
// every player with a result in at least one reveal), the summary as the Worker makes it of them (gameSummary).
function ended(who: Who, me: string, players: LobbyPlayer[], revealed: number, sums: [string, number][]): RoomView {
  const totals = sums.map(([nick, votes]) => ({ nick, votes }));
  return { ...closed(who, me, players), summary: gameSummary({ revealed, totals }) };
}

// A leader's screen with latecomers waiting to be let in (S-08), in the order of asking; only a leader gets them.
function withRequests(view: RoomView, requests: string[], returning: string[] = []): RoomView {
  return { ...view, requests, returning };
}

