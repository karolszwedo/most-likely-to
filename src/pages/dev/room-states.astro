---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import JoinForm from "@/components/room/JoinForm";
import JoinWaiting from "@/components/room/JoinWaiting";
import Landing from "@/components/room/Landing.astro";
import NewGameForm from "@/components/room/NewGameForm";
import OpenRoomNotice from "@/components/room/OpenRoomNotice.astro";
import { ROOM_FRAME } from "@/components/room/room-frame";
import RoomCard from "@/components/room/RoomCard.astro";
import RoomMessage from "@/components/room/RoomMessage.astro";
import RoomScreen from "@/components/room/RoomScreen";
// Server only (lessons.md): the islands get just the id and name of each category.
import { CATEGORIES } from "@/data/questions";
import type { EmoteMessage } from "@/lib/rooms/emotes";
import { roomErrorMessage } from "@/lib/rooms/errors";
import type { ListQuestion, LobbyPlayer, RoomView } from "@/lib/rooms/shared";
import { gameSummary } from "@/lib/rooms/summary";

// Every state of the room screens side by side: the visual gate of /10x-ui. Sample data only: no database queries,
// no Realtime, no polling, no reports; the round's buttons only answer "ok" on this page (RoomScreen's preview). Local
// only; a production build answers an empty 404.
// From lg (1024 px) each room state (/r/…) is as wide as the page (ROOM_FRAME, one per row), because its lg: classes
// answer the window's width, not the frame's; below lg every frame is 512 px, as before. The header, / and /j/… keep
// their 512 px frames; the wide header and the host's bar at the window's bottom edge are on /dev/room-window.
// (Status instead of an early `return`, which crashes typescript-eslint's no-misused-promises in .astro files.)
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const categories = CATEGORIES.map(({ id, name }) => ({ id, name }));
const newGameCard = {
  title: "Nowa gra",
  description: "Wpisz swój nick i wybierz kategorie. Link dla graczy dostaniesz od razu.",
};
const joinCard = { title: "Dołącz do gry", description: "Wpisz nick i jesteś w grze. Konto nie jest potrzebne." };
// /j/… during a game (S-08): the latecomer's request form, and the same after "Odrzuć".
const requestCard = {
  title: "Poproś o wejście",
  description: "Gra już trwa, więc prowadzący musi cię wpuścić. Wpisz nick i poproś o wejście.",
};
const requestAgainCard = {
  title: "Prowadzący cię nie wpuścił.",
  description: "Możesz poprosić o wejście jeszcze raz.",
};

// Sample room, link and players; the link has the real length (22 base64url characters after /j/).
const ROOM_ID = "3f2b8c1e-7a4d-4e9b-9c2a-5d6e7f8a9b0c";
const LINK_TOKEN = "Xq3vL9tR2mWb7KpZ0aYc_e";
const LINK_URL = `https://most-likely-to.charlesonthewave.workers.dev/j/${LINK_TOKEN}`;
// color: each player's stored colour (S-18), here the first free one on the way in, so the host 0 and then each guest
// the next one, as before the players picked their own.
const hostAlone: LobbyPlayer[] = [{ nick: "Ola", host: true, cohost: false, color: 0 }];
const twoPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true, cohost: false, color: 0 },
  { nick: "Bartek", host: false, cohost: false, color: 1 },
];
const fewPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true, cohost: false, color: 0 },
  { nick: "Bartek", host: false, cohost: false, color: 1 },
  { nick: "Kasia 🎉", host: false, cohost: false, color: 2 },
];
// Eight players, with a nick of exactly 20 characters (nickLength) and one with an emoji.
const eightPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true, cohost: false, color: 0 },
  { nick: "Bartek", host: false, cohost: false, color: 1 },
  { nick: "Najdłuższy nick 20zn", host: false, cohost: false, color: 2 },
  { nick: "Kasia 🎉", host: false, cohost: false, color: 3 },
  { nick: "Zosia", host: false, cohost: false, color: 4 },
  { nick: "Kuba", host: false, cohost: false, color: 5 },
  { nick: "Marta", host: false, cohost: false, color: 6 },
  { nick: "Igor", host: false, cohost: false, color: 7 },
];
const guestView: LobbyPlayer[] = [
  { nick: "Bartek", host: true, cohost: false, color: 0 },
  { nick: "Ola", host: false, cohost: false, color: 1 },
  { nick: "Kasia 🎉", host: false, cohost: false, color: 2 },
  { nick: "Zosia", host: false, cohost: false, color: 3 },
];

// The round: five players in seat order, the host first (Ola); the guest's screens are Bartek's.
const roundPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true, cohost: false, color: 0 },
  { nick: "Bartek", host: false, cohost: false, color: 1 },
  { nick: "Kasia 🎉", host: false, cohost: false, color: 2 },
  { nick: "Zosia", host: false, cohost: false, color: 3 },
  { nick: "Kuba", host: false, cohost: false, color: 4 },
];
// Twenty players (the most a room is planned for): five nicks of 20 characters, the widest letters, emoji.
const twentyPlayers: LobbyPlayer[] = [
  "Ola",
  "Najdłuższy nick 20zn",
  "Kasia 🎉",
  "Bartłomiej Kowalczyk",
  "Zosia",
  "Kuba",
  "Małgorzata Wiśniewsk",
  "🦄 Jednorożec",
  "Igor",
  "Marta",
  "Przemysław Grzegorz",
  "Ania 🍕",
  "Szczepan Brzęczyszcz",
  "Tomek",
  "Ewa",
  "WWWWWWWWWWWWWWWWWWWW",
  "Jan",
  "Łukasz 🎮",
  "Natalia",
  "Krzysztof",
].map((nick, index) => ({ nick, host: index === 0, cohost: false, color: index }));

// S-07: a guest the host made a co-host, on every screen's list.
function withCohost(players: LobbyPlayer[], nick: string): LobbyPlayer[] {
  return players.map((player) => ({ ...player, cohost: player.nick === nick }));
}
// Bartek has the co-host role: his own screens (a leader without the host's things) and the others' lists.
const cohostFew = withCohost(fewPlayers, "Bartek");
const cohostRound = withCohost(roundPlayers, "Bartek");
// The host's list with the widest row: the switch pressed next to a nick of 20 characters.
const cohostEight = withCohost(eightPlayers, "Najdłuższy nick 20zn");

// S-18: the 21st player (Wiktor) gets colour 0 again, the host's: every colour of the palette is taken by another
// player, his own too.
const twentyOnePlayers: LobbyPlayer[] = [...twentyPlayers, { nick: "Wiktor", host: false, cohost: false, color: 0 }];

// Sample questions: the ending after "Kto z nas najprawdopodobniej", as the Worker sends it; the long one is the
// longest in the base.
const QUESTION = "spóźniłby się na własne urodziny";
const LONG_QUESTION = "przeszedłby grę na najwyższym poziomie tylko po to, żeby się pochwalić";
const QUESTION_ID = "na-co-dzien-001";

// The host's game's question list after a review (S-06), as the Worker sends it: 15 questions in the order of
// positions. 1 reworded, 2 and 9 removed (a position is never used again, so the gaps stay), 16 drawn with "Dolosuj
// pytanie", 17 the host's own, 90 characters long (the most a question may have, as questionLength counts it).
const QUESTION_LIST: ListQuestion[] = [
  { position: 1, text: "wypiłby mleko prosto z kartonu", own: true },
  { position: 3, text: "spóźniłby się na własne urodziny", own: false },
  { position: 4, text: "zjadłby wszystkie przekąski, zanim przyjdą goście", own: false },
  { position: 5, text: "oglądałby ten sam serial po raz piąty, zamiast zacząć nowy", own: false },
  { position: 6, text: "wygrałby teleturniej w telewizji", own: false },
  { position: 7, text: "zasnąłby w kinie na najgłośniejszej scenie", own: false },
  { position: 8, text: "zgubiłby telefon, trzymając go w ręce", own: false },
  { position: 10, text: LONG_QUESTION, own: false },
  { position: 11, text: "krzyczałby na sędziego przez telewizor", own: false },
  { position: 12, text: "biegałby codziennie o szóstej rano", own: false },
  { position: 13, text: "odpowiedziałby „do wszystkich” na maila do jednej osoby", own: false },
  { position: 14, text: "skoczyłby na bungee", own: false },
  { position: 15, text: "zostałby przewodniczącym samorządu", own: false },
  { position: 16, text: "mieszkałby za dziesięć lat na innym kontynencie", own: false },
  {
    position: 17,
    text: "zorganizowałby wieczór gier dla całej ekipy i zapomniał, że to on miał przynieść przekąski",
    own: true,
  },
];
// "Popraw" on position 3, with a longer text in its field.
const EDITED_TEXT = "spóźniłby się na własne urodziny, a potem obraził, że nikt nie czekał z tortem";
// The players' emotes on the screen (S-16): three, a nick with an emoji among them; and the most at once
// (EMOTE_MAX_SHOWN).
const threeEmotes: EmoteMessage[] = [
  { nick: "Zosia", emote: "heart" },
  { nick: "Kasia 🎉", emote: "cry" },
  { nick: "Ola", emote: "skull" },
];
const fiveEmotes: EmoteMessage[] = [
  ...threeEmotes,
  { nick: "Bartek", emote: "angry" },
  { nick: "Kuba", emote: "like" },
];
// "Dodaj własne pytanie" with 114 characters, past the limit of 90.
const TOO_LONG_QUESTION =
  "przyszedłby na wieczór gier z własną planszówką, przeczytał całą instrukcję na głos i przegrał w pierwszej rundzie";

// Whose screen it is: the host, a guest with the co-host role (S-07: a leader, role "guest", leader true) or a guest.
// The co-host's own row must carry the role too (withCohost), as room_lobby gives it.
type Who = "host" | "cohost" | "guest";

function seat(who: Who): Pick<RoomView, "role" | "leader"> {
  return { role: who === "host" ? "host" : "guest", leader: who !== "guest" };
}

// questions: the host's game's question list in the lobby (S-06); null until "Przejrzyj pytania", and for a guest.
function lobby(who: Who, me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "lobby",
    ...seat(who),
    me,
    players,
    round: null,
    requests: [],
    questionsLeft: null,
    questions: null,
    summary: null,
  };
}

// The host's lobby once "Przejrzyj pytania" drew the game's question list; [] once every question was removed.
function withQuestions(view: RoomView, questions: ListQuestion[]): RoomView {
  return { ...view, questions };
}

// round: the question's number in the game, whether the host skipped the one before it (S-03) and who may vote in it
// (eligible, S-08). By default every player was in the room when the round opened, so all of them may vote in it, and
// no latecomer is waiting (requests; withRequests below).
function voting(
  who: Who,
  me: string,
  players: LobbyPlayer[],
  voted: string[],
  question: string | null = QUESTION,
  round: { number?: number; afterSkip?: boolean; eligible?: string[] } = {},
): RoomView {
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: {
      number: round.number ?? 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "voting",
      eligible: round.eligible ?? players.map(({ nick }) => nick),
      voted,
      me_voted: voted.includes(me),
      after_skip: round.afterSkip ?? false,
      question,
    },
    requests: [],
    questionsLeft: null,
    questions: null,
    summary: null,
  };
}

// results: [nick, votes] in seat order, every player of the round; ballots = votes + abstentions.
function revealed(
  who: Who,
  me: string,
  players: LobbyPlayer[],
  results: [string, number][],
  abstained: number,
  question: string | null = QUESTION,
  questionsLeft = true,
): RoomView {
  const votes = results.reduce((sum, [, count]) => sum + count, 0);
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: {
      number: 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "revealed",
      results: results.map(([nick, count]) => ({ nick, votes: count })),
      abstained,
      ballots: votes + abstained,
      question,
    },
    requests: [],
    // Only a leader learns whether the game has a question left.
    questionsLeft: who === "guest" ? null : questionsLeft,
    questions: null,
    summary: null,
  };
}

// A leader skipped the last question of the game's pool: no round follows it, its votes are gone.
function skipped(who: Who, me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "playing",
    ...seat(who),
    me,
    players,
    round: { number: 7, phase: "skipped" },
    requests: [],
    questionsLeft: who === "guest" ? null : false,
    questions: null,
    summary: null,
  };
}

// The end of the evening: the room is closed, no round, no counts. With no revealed question (closed from the lobby,
// every question skipped, or ended during the first one) there is no summary either.
function closed(who: Who, me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "closed",
    ...seat(who),
    me,
    players,
    round: null,
    requests: [],
    questionsLeft: null,
    questions: null,
    summary: null,
  };
}

// The end of a game with reveals (S-15): sums as room_lobby would give them (game_totals: [nick, votes] in seat order,
// every player with a result in at least one reveal), the summary as the Worker makes it of them (gameSummary).
function ended(who: Who, me: string, players: LobbyPlayer[], revealed: number, sums: [string, number][]): RoomView {
  const totals = sums.map(([nick, votes]) => ({ nick, votes }));
  return { ...closed(who, me, players), summary: gameSummary({ revealed, totals }) };
}

// A leader's screen with latecomers waiting to be let in (S-08), in the order of asking; only a leader gets them.
function withRequests(view: RoomView, requests: string[]): RoomView {
  return { ...view, requests };
}

// S-08: Kuba (the last seat) was let in while question 1 was voting: he sees it, and votes from the next question on.
const beforeKuba = ["Ola", "Bartek", "Kasia 🎉", "Zosia"];

// Ola 2, Kasia 2 (a tie, in seat order), three zeros, one abstention: 5 ballots from 5 players.
const fiveResults: [string, number][] = [
  ["Ola", 2],
  ["Bartek", 0],
  ["Kasia 🎉", 2],
  ["Zosia", 0],
  ["Kuba", 0],
];
// Decision D3: the host revealed after a single vote.
const oneVote: [string, number][] = [
  ["Ola", 0],
  ["Bartek", 0],
  ["Kasia 🎉", 1],
  ["Zosia", 0],
  ["Kuba", 0],
];
const noVotes: [string, number][] = roundPlayers.map(({ nick }) => [nick, 0]);
// 17 votes and 3 abstentions from 20 players: ties at 3, 2 and 1, and zeros.
const twentyCounts = [3, 2, 0, 3, 1, 0, 2, 1, 0, 0, 1, 0, 0, 2, 0, 1, 0, 0, 1, 0];
const twentyResults: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, twentyCounts[index]]);
// 20 players, only 5 got votes (15 votes, 5 abstentions): Karol's example of a readable pie.
const fewOfTwentyCounts = [5, 0, 0, 4, 0, 0, 3, 0, 0, 0, 2, 0, 0, 0, 0, 1, 0, 0, 0, 0];
const fewOfTwenty: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, fewOfTwentyCounts[index]]);
// 20 players, 11 got votes (16 votes, 4 abstentions): a pie of 11 slices.
const elevenOfTwentyCounts = [3, 2, 0, 2, 1, 0, 1, 1, 0, 0, 1, 0, 1, 2, 0, 1, 0, 0, 1, 0];
const elevenOfTwenty: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, elevenOfTwentyCounts[index]]);
// Every vote for one player: the pie is a full circle.
const allForOne: [string, number][] = [
  ["Ola", 0],
  ["Bartek", 0],
  ["Kasia 🎉", 4],
  ["Zosia", 0],
  ["Kuba", 0],
];

// The sums of a game's reveals (S-15), in seat order. Three sums of one person each fill the top; two zeros.
const summarySums: [string, number][] = [
  ["Ola", 3],
  ["Bartek", 5],
  ["Kasia 🎉", 2],
  ["Zosia", 0],
  ["Kuba", 0],
];
// Four people at the top with the same sum: all four, past the limit of 3.
const topTieSums: [string, number][] = [
  ["Ola", 2],
  ["Bartek", 2],
  ["Kasia 🎉", 2],
  ["Zosia", 2],
  ["Kuba", 0],
];
// Everyone got a vote; the three at 1 would make five at the top, so the list ends after two.
const noZeroSums: [string, number][] = [
  ["Ola", 4],
  ["Bartek", 1],
  ["Kasia 🎉", 3],
  ["Zosia", 1],
  ["Kuba", 1],
];
// Everyone abstained in every reveal: nobody has the most votes, and everyone is among the zeros.
const abstainedSums: [string, number][] = roundPlayers.map(({ nick }) => [nick, 0]);
// 20 players after 12 questions: six at the top with 3 each (four nicks of 20 characters among them), six with 1 or 2,
// eight zeros (one of them the widest nick).
const bigRoomCounts = [3, 3, 0, 3, 1, 0, 3, 2, 0, 0, 3, 1, 0, 3, 0, 0, 2, 1, 0, 2];
const bigRoomSums: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, bigRoomCounts[index]]);
---

{isDev && (
  <Layout title="Stany pokoju">
    <main class="bg-background text-foreground min-h-screen p-6">
      <h1 class="text-2xl font-semibold">Stany pokoju</h1>
      <p class="text-muted-foreground mt-2 max-w-3xl text-sm">
        Te same klocki co na /, /j/… i /r/…, z przykładowymi danymi: strona nie pyta bazy i nie słucha zmian, więc listy
        graczy stoją w miejscu, a ekran czekania na prowadzącego sam nigdzie nie przechodzi. Hover i focus-visible
        sprawdzasz na stanach 2, 9, 14, 25, 28, 36, 42, 45f, 64, 69, 72, 74, 86, 91, 96, 102 i 110: najedź myszą na pola
        i przyciski albo przejdź Tabem. Wysłanie formularza na tej stronie naprawdę idzie do API (zalogowany host założy
        pokój), a „Wyloguj” w nagłówku naprawdę wylogowuje. Przyciski gry („Zacznij grę”, „Zagłosuj”, „Odsłoń wynik”,
        „Pomiń pytanie”, „Zakończ grę”, „Następne pytanie”, „Wpuść”, „Odrzuć”, przełącznik „współhost”, „Przejrzyj
        pytania”, „Popraw”, „Zapisz”, „Usuń”, „Dolosuj pytanie”, „Dodaj”, kciuki „Dobre pytanie” i „Słabe pytanie”,
        emotki, własna kropka koloru i paleta) niczego nie wysyłają: głos od razu pokazuje „Głos oddany”, kciuk od razu
        się zaznacza, a drugie dotknięcie go zdejmuje, emotka gasi pasek na 3 s bez dymku, kolor z palety zamyka paletę
        bez zmiany kropki, pytania „Na pewno…?” i „Anuluj” działają naprawdę, a wysłana akcja prowadzącego i przełącznik
        roli zostają w stanie wysyłania. Na liście pytań „Usuń” i „Zapisz” zmieniają listę od razu, tylko na swoim
        ekranie, a fokus idzie dalej jak na prawdziwej stronie; dolosowane i dodane pytanie się nie pojawia, a
        „Przejrzyj pytania” bez listy (72) zostaje w stanie losowania. Przełącznik „Koło” / „Paski” w odsłonie działa
        naprawdę, tylko na swoim ekranie. Pasek emotek stoi tu pod każdym ekranem, a dymki (94, 95) stoją zatrzymane w
        locie z rogu ramki w górę i nie znikają; na prawdziwej stronie pasek jest przypięty do dołu okna telefonu, a od
        1280 px stoi przy prawej krawędzi okna, dymek płynie w górę i gaśnie po 3 s. Od 1024 px stany pokoju mają
        szerokość strony, jak na laptopie; pokój w prawdziwym oknie, z szerokim nagłówkiem, pokazuje /dev/room-window.
      </p>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Nagłówek</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 xl:grid-cols-3">
          <section id="header-host" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">a. Zalogowany host</h2>
            <AppHeader signedIn />
          </section>

          <section id="header-guest" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">b. Gość lub niezalogowany</h2>
            <AppHeader signedIn={false} />
          </section>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Strona główna</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 xl:grid-cols-3">
          <section id="home-guest" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">1. Niezalogowany</h2>
            <Landing titleAs="h2" />
          </section>

          <section id="new-default" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">2. Nowa gra: domyślny · hover · focus-visible</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm categories={categories} preview={{ idPrefix: "new-default" }} client:load />
            </RoomCard>
          </section>

          <section id="new-nick-error" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">3. Błąd: za długi nick</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                preview={{ idPrefix: "new-nick-error", nick: "Bardzo długi nick gracza", showErrors: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="new-no-categories" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">4. Błąd: brak kategorii</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                preview={{ idPrefix: "new-no-categories", nick: "Ola", noCategories: true, showErrors: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="new-open-room" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">5. Z otwartym pokojem</h2>
            <div class="flex flex-col gap-6">
              <OpenRoomNotice roomId={ROOM_ID} players={4} status="lobby" />
              <RoomCard titleAs="h2" {...newGameCard}>
                <NewGameForm
                  categories={categories}
                  roomToClose={{ players: 4 }}
                  preview={{ idPrefix: "new-open-room" }}
                  client:load
                />
              </RoomCard>
