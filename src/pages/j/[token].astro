---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import { LINK_PREVIEW } from "@/components/room/game-intro";
import { linkTitle, type LinkForm, type LinkView } from "@/components/room/link-page";
import LinkScreen from "@/components/room/LinkScreen.astro";
import { roomErrorMessage } from "@/lib/rooms/errors";
import { joinRequestState, roomLink, roomLobby } from "@/lib/rooms/server";
import { nickLength } from "@/lib/rooms/shared";
import { LINK_TOKEN_PATTERN, PLAYER_TOKEN_PATTERN, playerCookieName, TAKEN_NICK_COOKIE } from "@/lib/rooms/tokens";
import { createClient, getPublicSupabaseConfig } from "@/lib/supabase";

// The host's link. A GET changes nothing, because Discord fetches the link for its preview, and the title and meta tags
// carry no room data: the preview card is the game's (LINK_PREVIEW), the same for every room and state. Someone
// already in the room (its host, or a guest with the room's cookie) goes straight to it, also once the game has
// started: a player who opens the link from Discord again gets back to the round. Anyone else
// sees the join form in the lobby; during a game, a latecomer asks a leader (the host or a co-host, S-07) to let them
// in (S-08): the request form, then a waiting screen that moves on to the room by itself, and after "Odrzuć" the form
// again with the nick asked with.
// The request's state comes from the room's cookie (join_request_state), never the question or anyone else's request.
// Once the game is over ("Zakończ grę", "Nowa gra" or the sweep), the link only says so: the room never opens again.
// What each state shows is LinkScreen's (src/components/room/LinkScreen.astro); this page loads it and sets the status.
type Page = LinkView | { kind: "inside"; roomId: string };

async function loadPage(linkToken: string): Promise<Page> {
  if (!LINK_TOKEN_PATTERN.test(linkToken)) return { kind: "unknown" };
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { kind: "error", linkToken, reason: "service_unavailable" };

  const link = await roomLink(supabase, linkToken);
  if (!link.ok) return { kind: "error", linkToken, reason: link.reason };
  if (link.status === "closed") return { kind: "closed" };
  if (link.status === "unknown") return { kind: "unknown" };

  // Only the host (a session) or a guest (this room's cookie) can be inside already; anyone else skips the lookup.
  const playerToken = Astro.cookies.get(playerCookieName(link.roomId))?.value;
  if (Astro.locals.user || playerToken) {
    const inside = await roomLobby(supabase, link.roomId, playerToken);
    if (!inside.ok) return { kind: "error", linkToken, reason: inside.reason };
    if (inside.lobby) return { kind: "inside", roomId: link.roomId };
  }
  const lobby = link.status === "open";

  // Without the room's cookie (or with one in another form, which has nothing in the room) there is no request yet.
  if (playerToken === undefined || !PLAYER_TOKEN_PATTERN.test(playerToken)) {
    return lobby ? { kind: "join", linkToken, rejectedReturn: null } : { kind: "started", linkToken, rejected: null };
  }
  // A request to join waits only while the game is in play; one to come back also in the lobby (S-04).
  const asked = await joinRequestState(supabase, link.roomId, playerToken);
  if (!asked.ok) return { kind: "error", linkToken, reason: asked.reason };
  const { request } = asked;
  // Let in between the two calls above, or the room closed meanwhile.
  if (request.state === "admitted") return { kind: "inside", roomId: link.roomId };
  if (request.state === "closed") return { kind: "closed" };
  if (request.state === "pending") {
    const returning = request.returning === true;
    return { kind: "waiting", linkToken, roomId: link.roomId, nick: request.nick, returning };
  }
  // Turned away; none and moved (this browser's place moved to another one, S-04) ask as anyone would. So does gone,
  // which comes here only in a race: room_link above answers unknown (404) for a game its host deleted (S-13), so gone
  // means it was deleted between the two calls, and the next load of this page is the 404. The type does not force
  // this: it falls through as none does.
  const rejected = request.state === "rejected" ? { nick: request.nick, returning: request.returning === true } : null;
  if (lobby) return { kind: "join", linkToken, rejectedReturn: rejected?.returning ? rejected.nick : null };
  return { kind: "started", linkToken, rejected };
}

const page = await loadPage(Astro.params.token ?? "");
// Status and Location instead of an early `return Astro.redirect(…)`, which crashes typescript-eslint's
// no-misused-promises in .astro files (src/pages/dev/ui-kitchen-sink.astro).
if (page.kind === "inside") {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", `/r/${page.roomId}`);
} else if (page.kind === "unknown") {
  Astro.response.status = 404;
} else if (page.kind === "closed") {
  Astro.response.status = 410;
} else if (page.kind === "error") {
  Astro.response.status = page.reason === "service_unavailable" ? 503 : 500;
}
const errorCode = Astro.url.searchParams.get("error");
const serverError = roomErrorMessage(errorCode);
// The form suggests the nick this browser remembers (S-14), except after "nick zajęty": then the field stays empty.
const suggestNick = errorCode !== "nick_taken";
// After a refusal of the nick as taken, the form offers to ask for the return to that place (S-04), with the nick from
// the link pages' short cookie (POST /api/rooms/join); after a refused return that may work in a moment, too. A nick
// the form would not take is no nick, and a leader's "Odrzuć" of a return offers it again with the request's nick.
const RETURN_OFFER = new Set(["nick_taken", "return_taken", "requests_full"]);
const cookieNick = Astro.cookies.get(TAKEN_NICK_COOKIE)?.value;
const flashNick =
  errorCode !== null && RETURN_OFFER.has(errorCode) && cookieNick !== undefined && nickLength(cookieNick) >= 1
    ? cookieNick
    : null;
const rejectedReturn =
  page.kind === "join"
    ? page.rejectedReturn
    : page.kind === "started" && page.rejected?.returning
      ? page.rejected.nick
      : null;
const takenNick = flashNick ?? rejectedReturn;
// With the question "To ty?" above the form, "nick zajęty" says nothing more; a refused return keeps its text.
const formError = errorCode === "nick_taken" && takenNick !== null ? null : serverError;
const form: LinkForm = { serverError: formError, suggestNick, takenNick };
// The waiting screen listens on the room's channel: the publishable key only, for Realtime (AGENTS.md).
const realtime = page.kind === "waiting" ? getPublicSupabaseConfig() : null;
const view = page.kind === "inside" ? null : page;
---

{view && (
  <Layout title={linkTitle(view)} preview={LINK_PREVIEW}>
    <AppHeader />
    <LinkScreen view={view} form={form} realtime={realtime} />
  </Layout>
)}
