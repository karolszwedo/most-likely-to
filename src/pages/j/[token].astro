---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import JoinForm from "@/components/room/JoinForm";
import JoinWaiting from "@/components/room/JoinWaiting";
import RoomCard from "@/components/room/RoomCard.astro";
import RoomMessage from "@/components/room/RoomMessage.astro";
import { roomErrorMessage } from "@/lib/rooms/errors";
import { joinRequestState, roomLink, roomLobby } from "@/lib/rooms/server";
import { LINK_TOKEN_PATTERN, playerCookieName } from "@/lib/rooms/tokens";
import { createClient, getPublicSupabaseConfig } from "@/lib/supabase";

// The host's link. A GET changes nothing, because Discord fetches the link for its preview, and the title and meta tags
// carry no room data. Someone already in the room (its host, or a guest with the room's cookie) goes straight to it,
// also once the game has started: a player who opens the link from Discord again gets back to the round. Anyone else
// sees the join form in the lobby; during a game, a latecomer asks a leader (the host or a co-host, S-07) to let them
// in (S-08): the request form, then a waiting screen that moves on to the room by itself, and after "Odrzuć" the form
// again with the nick asked with.
// The request's state comes from the room's cookie (join_request_state), never the question or anyone else's request.
// Once the game is over ("Zakończ grę", "Nowa gra" or the sweep), the link only says so: the room never opens again.
type Page =
  | { kind: "join"; linkToken: string }
  | { kind: "inside"; roomId: string }
  | { kind: "unknown" }
  // A game in play: the request form; rejectedNick is the nick asked with before, once a leader turned it away.
  | { kind: "started"; linkToken: string; rejectedNick: string | null }
  | { kind: "waiting"; linkToken: string; roomId: string; nick: string }
  | { kind: "closed" }
  | { kind: "error"; reason: string };

async function loadPage(linkToken: string): Promise<Page> {
  if (!LINK_TOKEN_PATTERN.test(linkToken)) return { kind: "unknown" };
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { kind: "error", reason: "service_unavailable" };

  const link = await roomLink(supabase, linkToken);
  if (!link.ok) return { kind: "error", reason: link.reason };
  if (link.status === "closed") return { kind: "closed" };
  if (link.status === "unknown") return { kind: "unknown" };

  // Only the host (a session) or a guest (this room's cookie) can be inside already; anyone else skips the lookup.
  const playerToken = Astro.cookies.get(playerCookieName(link.roomId))?.value;
  if (Astro.locals.user || playerToken) {
    const inside = await roomLobby(supabase, link.roomId, playerToken);
    if (!inside.ok) return { kind: "error", reason: inside.reason };
    if (inside.lobby) return { kind: "inside", roomId: link.roomId };
  }
  if (link.status === "open") return { kind: "join", linkToken };

  // A game in play. Without the room's cookie there is no request yet.
  if (playerToken === undefined) return { kind: "started", linkToken, rejectedNick: null };
  const asked = await joinRequestState(supabase, link.roomId, playerToken);
  if (!asked.ok) return { kind: "error", reason: asked.reason };
  const { request } = asked;
  // Let in between the two calls above, or the room closed meanwhile.
  if (request.state === "admitted") return { kind: "inside", roomId: link.roomId };
  if (request.state === "closed") return { kind: "closed" };
  if (request.state === "pending") return { kind: "waiting", linkToken, roomId: link.roomId, nick: request.nick };
  return { kind: "started", linkToken, rejectedNick: request.state === "rejected" ? request.nick : null };
}

const page = await loadPage(Astro.params.token ?? "");
// Status and Location instead of an early `return Astro.redirect(…)`, which crashes typescript-eslint's
// no-misused-promises in .astro files (src/pages/dev/ui-kitchen-sink.astro).
if (page.kind === "inside") {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", `/r/${page.roomId}`);
} else if (page.kind === "unknown") {
  Astro.response.status = 404;
} else if (page.kind === "closed") {
  Astro.response.status = 410;
} else if (page.kind === "error") {
  Astro.response.status = page.reason === "service_unavailable" ? 503 : 500;
}
const errorCode = Astro.url.searchParams.get("error");
const serverError = roomErrorMessage(errorCode);
// The form suggests the nick this browser remembers (S-14), except after "nick zajęty": then the field stays empty.
const suggestNick = errorCode !== "nick_taken";
// The waiting screen listens on the room's channel: the publishable key only, for Realtime (AGENTS.md).
const realtime = page.kind === "waiting" ? getPublicSupabaseConfig() : null;
---

{page.kind !== "inside" && (
  <Layout title="Dołącz do gry">
    <AppHeader />
    <main class="mx-auto flex w-full max-w-lg flex-col gap-6 px-4 py-8">
      {page.kind === "join" && (
        <RoomCard title="Dołącz do gry" description="Wpisz nick i jesteś w grze. Konto nie jest potrzebne.">
          <JoinForm linkToken={page.linkToken} serverError={serverError} suggestNick={suggestNick} client:load />
        </RoomCard>
      )}
      {/* The same text for an old link (replaced when a leader removed a player, S-09) and one copied only in part. */}
      {page.kind === "unknown" && (
        <RoomMessage title="Ten link nie działa." text="Sprawdź, czy skopiował się cały, albo poproś hosta o nowy." />
      )}
      {page.kind === "started" && page.rejectedNick === null && (
        <RoomCard
          title="Poproś o wejście"
          description="Gra już trwa, więc prowadzący musi cię wpuścić. Wpisz nick i poproś o wejście."
        >
          <JoinForm
            linkToken={page.linkToken}
            serverError={serverError}
            variant="request"
            suggestNick={suggestNick}
            client:load
          />
        </RoomCard>
      )}
      {page.kind === "started" && page.rejectedNick !== null && (
        <RoomCard title="Prowadzący cię nie wpuścił." description="Możesz poprosić o wejście jeszcze raz.">
          <JoinForm
            linkToken={page.linkToken}
            serverError={serverError}
            variant="request-again"
            initialNick={page.rejectedNick}
            client:load
          />
        </RoomCard>
      )}
      {page.kind === "waiting" && (
        <JoinWaiting roomId={page.roomId} linkToken={page.linkToken} nick={page.nick} realtime={realtime} client:load />
      )}
      {page.kind === "closed" && <RoomMessage title="Ta gra już się skończyła." text="Poproś hosta o nowy link." />}
      {page.kind === "error" && (
        <RoomMessage title="Nie udało się otworzyć linku." text={roomErrorMessage(page.reason)} />
      )}
    </main>
  </Layout>
)}
