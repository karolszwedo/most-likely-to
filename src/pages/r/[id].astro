---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import { ROOM_FRAME } from "@/components/room/room-frame";
import RoomScreen from "@/components/room/RoomScreen";
import RoomMessage from "@/components/room/RoomMessage.astro";
import { logEvent } from "@/lib/log";
import { roomErrorMessage } from "@/lib/rooms/errors";
import { joinRequestState, leaderQuestionsLeft, roomLobby, roomView } from "@/lib/rooms/server";
import type { RoomView } from "@/lib/rooms/shared";
import { PLAYER_TOKEN_PATTERN, playerCookieName, UUID_PATTERN } from "@/lib/rooms/tokens";
import { createClient, getPublicSupabaseConfig } from "@/lib/supabase";

// The room for its host (session) or a player (the cookie from joining), in the lobby or with a game in play; the
// island gets the room's state with the round's question as text (RoomView), and a leader's view the players' link on
// this page's origin (S-09). Anyone else, a malformed id and a room that does not exist get the same 404. A player a
// leader removed (S-09) gets the same 404 with its own text: an open tab reloads on the state's 404 (useRoomState),
// and the page knows the player by the room's cookie. With a cookie the text tells a closed room from one that is gone
// or open, as join_request_state already does for anon (review of S-09, F6; room ids are random); a game its host
// deleted (S-13) gets the same 404 with its own text. The island keeps the state live: the publishable key reaches it
// as props, only for the room's Realtime channel (AGENTS.md); null means polling only.
type Page =
  | { kind: "lobby"; roomId: string; lobby: RoomView }
  | { kind: "outside" }
  | { kind: "removed" }
  // The old device of a guest a leader let back to their place on another one (S-04): the place's nick.
  | { kind: "moved"; nick: string }
  // A guest of a game its host deleted from the list of own games (S-13): the game is gone, not the guest removed.
  | { kind: "gone" }
  | { kind: "error"; reason: string };

async function loadPage(roomId: string): Promise<Page> {
  if (!UUID_PATTERN.test(roomId)) return { kind: "outside" };
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { kind: "error", reason: "service_unavailable" };

  const playerToken = Astro.cookies.get(playerCookieName(roomId))?.value;
  const result = await roomLobby(supabase, roomId, playerToken);
  if (!result.ok) return { kind: "error", reason: result.reason };
  if (!result.lobby) {
    // As in GET /api/rooms/<id>/lobby (audit L3): the flags tell a stranger from a host or a guest who lost the way in.
    logEvent("warn", {
      route: "/r/[id]",
      roomId,
      hasUser: Boolean(Astro.locals.user),
      hasPlayerCookie: playerToken !== undefined,
    });
    // The room's cookie is set only by joining this room or asking to (src/pages/api/rooms/join.ts). A token in it
    // that is neither a player's nor a request belonged to a player a leader removed: only remove_player deletes a
    // player, and the token's hash goes with it. A token whose place a leader moved to another device ("Wpuść" of a
    // request to come back, S-04) left a trace: moved. A room its host deleted since then (delete_game, S-13: the
    // players and their hashes go with the room) answers "gone", which is no removal. A room closed since then
    // answers "closed": the general text.
    if (playerToken !== undefined && PLAYER_TOKEN_PATTERN.test(playerToken)) {
      const asked = await joinRequestState(supabase, roomId, playerToken);
      if (!asked.ok) return { kind: "error", reason: asked.reason };
      if (asked.request.state === "none") return { kind: "removed" };
      if (asked.request.state === "gone") return { kind: "gone" };
      if (asked.request.state === "moved") return { kind: "moved", nick: asked.request.nick };
    }
    return { kind: "outside" };
  }

  return {
    kind: "lobby",
    roomId,
    lobby: roomView(result.lobby, roomId, leaderQuestionsLeft(result.lobby), Astro.url.origin),
  };
}

const page = await loadPage(Astro.params.id ?? "");
const realtime = getPublicSupabaseConfig();
if (page.kind === "outside" || page.kind === "removed" || page.kind === "moved" || page.kind === "gone") {
  Astro.response.status = 404;
} else if (page.kind === "error") {
  Astro.response.status = page.reason === "service_unavailable" ? 503 : 500;
}
const TITLES: Record<Page["kind"], string> = {
  lobby: "Pokój",
  outside: "Nie jesteś w tym pokoju",
  removed: "Usunięto cię z pokoju",
  moved: "Grasz na innym urządzeniu",
  gone: "Tej gry już nie ma",
  error: "Pokój",
};
const title = TITLES[page.kind];
---

<Layout title={title}>
  <AppHeader wide />
  <main class:list={["mx-auto flex w-full flex-col gap-6 px-4 py-8", ROOM_FRAME]}>
    {page.kind === "lobby" && <RoomScreen roomId={page.roomId} initial={page.lobby} realtime={realtime} client:load />}
    {page.kind === "outside" && <RoomMessage title="Nie jesteś w tym pokoju." text="Poproś hosta o link." />}
    {page.kind === "removed" && (
      <RoomMessage
        title="Usunięto cię z pokoju."
        text="Jeśli to pomyłka albo host się zgodzi, możesz wrócić: poproś go o nowy link."
      />
    )}
    {page.kind === "moved" && (
      <RoomMessage
        title="Grasz teraz na innym urządzeniu."
        text={`Prowadzący wpuścił cię tam z powrotem jako ${page.nick}. Tę kartę możesz zamknąć.`}
      />
    )}
    {page.kind === "gone" && (
      <RoomMessage title="Tej gry już nie ma." text="Host ją usunął. Na następną grę poproś go o nowy link." />
    )}
    {page.kind === "error" && (
      <RoomMessage title="Nie udało się otworzyć pokoju." text={roomErrorMessage(page.reason)} />
    )}
  </main>
</Layout>
