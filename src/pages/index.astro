---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import Landing from "@/components/room/Landing.astro";
import HostGamesLink from "@/components/room/HostGamesLink.astro";
import NewGameForm from "@/components/room/NewGameForm";
import OpenRoomNotice from "@/components/room/OpenRoomNotice.astro";
import RoomCard from "@/components/room/RoomCard.astro";
// Server only (lessons.md): the island gets just the id and name of each category.
import { CATEGORIES } from "@/data/questions";
import { roomErrorMessage } from "@/lib/rooms/errors";
import { hostOpenRoomId, roomLobby } from "@/lib/rooms/server";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const serverError = roomErrorMessage(Astro.url.searchParams.get("error"));
const categories = CATEGORIES.map(({ id, name }) => ({ id, name }));

// The host's open room, in the lobby or with a game in play, for "Wróć do pokoju" and for the question before
// "Nowa gra" closes it (create_room closes either and asks first when guests are in it). If the database does not
// answer, the form still shows and creating the game reports the error.
async function findOpenRoom() {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return null;
  const open = await hostOpenRoomId(supabase);
  if (!open.ok || !open.roomId) return null;
  const result = await roomLobby(supabase, open.roomId);
  if (!result.ok || !result.lobby) return null;
  const { players, status } = result.lobby;
  // hostOpenRoomId finds only a room in the lobby or with a game in play.
  if (status === "closed") return null;
  return { id: open.roomId, status, players: players.length, hasGuests: players.some((player) => !player.host) };
}

const openRoom = user ? await findOpenRoom() : null;
const roomToClose = openRoom?.hasGuests ? { players: openRoom.players } : null;
---

<Layout title={user ? "Nowa gra" : undefined}>
  <AppHeader />
  <main class="mx-auto flex w-full max-w-lg flex-col gap-6 px-4 py-8">
    {user ? (
      <>
        {openRoom && <OpenRoomNotice roomId={openRoom.id} players={openRoom.players} status={openRoom.status} />}
        <RoomCard
          title="Nowa gra"
          description="Wpisz swój nick i wybierz kategorie. Link dla graczy dostaniesz od razu."
        >
          <NewGameForm categories={categories} roomToClose={roomToClose} serverError={serverError} client:load />
        </RoomCard>
        {/* The host's ended games (S-13, "Twoje gry"), under the card with or without an open room. */}
        <HostGamesLink />
      </>
    ) : (
      <Landing />
    )}
  </main>
</Layout>
