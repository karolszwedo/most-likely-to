---
import Layout from "@/layouts/Layout.astro";
import SignInCard from "@/components/auth/SignInCard.astro";
import SignInForm from "@/components/auth/SignInForm";
import HeaderActions from "@/components/room/HeaderActions";
import { authErrorMessage } from "@/lib/auth-errors";
import { messages } from "@/lib/i18n";

// Our endpoints send only `error`. Supabase sends OAuth state errors (e.g. after 300 s) straight here, the Site URL,
// with a general `error` and the precise `error_code`, so `error_code` wins.
const params = Astro.url.searchParams;
const { lang } = Astro.locals;
const t = messages(lang);
const error = authErrorMessage(params.get("error_code") ?? params.get("error"), t);
---

<Layout lang={lang} title={t.pages.titles.signIn}>
  {/* No header here, only the switch of the screen's language in its corner (S-27); the card keeps clear of it. */}
  <div class="absolute top-3 right-4">
    <HeaderActions signedIn={false} place={null} next={Astro.url.pathname + Astro.url.search} lang={lang} client:load />
  </div>
  <main class="bg-background flex min-h-screen items-center justify-center px-4 py-14">
    <SignInCard serverError={error}>
      <SignInForm lang={lang} client:load />
    </SignInCard>
  </main>
</Layout>
